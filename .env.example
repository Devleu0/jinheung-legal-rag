# Approved authentication value from open.law.go.kr, not data.go.kr serviceKey
LAW_OC=
OPENAI_API_KEY=
RETRIEVAL_BACKEND=elastic_chroma
USE_GPT=1
# Only relevant to the legacy demo; production always uses semantic embeddings
USE_EMBEDDINGS=0
EMBEDDING_MODEL=text-embedding-3-small
# Default chat provider: openai or gemini. UI can select either configured provider.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
ELASTIC_URL=http://127.0.0.1:9200
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
INDEX_POINTER=runtime/active-index.json
FUSION_VARIANT=rrf
MAX_COSINE_DISTANCE=0.55
DB_PATH=runtime/chat.db
# Offline UI demo only: set RETRIEVAL_BACKEND=demo and USE_GPT=0
